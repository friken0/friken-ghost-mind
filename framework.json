      "driver": "authored reply graph",
      "contentSchema": "friktal.turn-out-of-time.v1",
      "authoring": "Turn-Out-Of-Time.md",
      "build": "python3 build.py --reply REPLY.json --reply-voice VOICE.json --output REPLY.html"
    }
  },
